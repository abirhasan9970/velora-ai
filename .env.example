# ============================================
# AI Agent - Environment Variables Template
# ============================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to Git.

# --- LLM Provider (Phase 3+) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- App Settings ---
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_MB=50
